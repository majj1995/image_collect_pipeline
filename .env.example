# 可选：本地数据目录；留空时使用项目下的 .data/
DATA_DIR=

# 可选：让 Node.js 后端通过 HTTP 代理访问外部 API。
# NODE_USE_ENV_PROXY=1
#
# 本地代理：使用西柚云等软件显示的 HTTP 或混合代理端口。
# HTTP_PROXY=http://127.0.0.1:<代理端口>
# HTTPS_PROXY=http://127.0.0.1:<代理端口>
#
# 企业远程代理：仅对公司明确提供并由你信任的代理显式开启。
# ALLOW_REMOTE_ENV_PROXY=1
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# 代理模式会忽略 NO_PROXY，确保外部素材下载不会退回未固定 IP 的直连。

# 以下 11 个来源无需配置提供方变量：
# Openverse、The Met、Cleveland Museum of Art、
# Art Institute of Chicago、Library of Congress、NASA、Internet Archive、
# Open Food Facts、Rijksmuseum、Microsoft Bing Ad Library、Snap Ads Gallery。

# Wikimedia Commons 免 API Key，但必须显式填写可识别请求方的单行 User-Agent 才会启用。
# 值需包含你自己的联系 URL、邮箱，或 Wikimedia 用户（格式：`(项目名; User:用户名)`）。
# 留空或值不合规时只会禁用 Wikimedia，不会影响其它来源或阻止应用启动。
WIKIMEDIA_USER_AGENT=

# Smithsonian 是第 12 个无需必填变量即可启用的来源；留空时自动使用官方 DEMO_KEY。
# 可选填写免费个人 Key，提高可用额度。
SMITHSONIAN_API_KEY=

# 需要免费 Key、免费账户或免费申请审批的 10 个来源。
# 变量值只由本地后端读取；留空时对应来源保持禁用。
BAIDU_QIANFAN_API_KEY=
SERPAPI_API_KEY=
EUROPEANA_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=
FLICKR_API_KEY=
HARVARD_ART_MUSEUMS_API_KEY=
DPLA_API_KEY=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Brave 与 DataForSEO 不属于持续免费的默认来源。
# 旧数据中的 provider ID 仍兼容，但下面这些旧变量不会启用新的生产来源：
# BRAVE_SEARCH_API_KEY=
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
